---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { resolveLang } from '../i18n/utils';
import '../styles/tokens.css';
import '../styles/global.css';

const SITE = "https://ampbenin.netlify.app";

const lang = resolveLang(Astro);
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const {
  title       = "AMP BENIN — Action Monde Productif",
  description = "Découvrez les actions de AMP BENIN pour un Bénin plus durable à travers des programmes communautaires et la mobilisation des jeunes.",
  url         = SITE,
  imagePath   = "https://res.cloudinary.com/diongmuh8/image/upload/f_auto,q_auto,w_800/v1780903879/ong-site/og-image-v16.jpg",
  image,
  keywords,
  type,
  hideChrome = false,
} = Astro.props;

const canonicalUrl = url.startsWith("http") ? url : `${SITE}${url}`;
const ogImage = image
  ? (image.startsWith("http") ? image : `${SITE}${image}`)
  : (imagePath.startsWith("http") ? imagePath : `${SITE}${imagePath}`);

---

<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />

    <!-- Préconnexions ressources externes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://res.cloudinary.com" />

    <!-- Google Fonts : Fraunces + DM Sans + Cairo (Arabic) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Cairo:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- Composant SEO centralisé -->
    <SEO
      title={title}
      description={description}
      image={ogImage}
      canonicalUrl={canonicalUrl}
      lang={lang}
      keywords={keywords}
      type={type}
    />

    <!-- Slot pour JSON-LD et autres overrides spécifiques à la page -->
    <slot name="head" />
  </head>

  <body>
    {!hideChrome && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {!hideChrome && <Footer />}

    <!-- Observer global pour animations fade-up au scroll -->
    <script is:inline>
      (function () {
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReduced) {
          document.querySelectorAll('.fade-up').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        document.querySelectorAll('.fade-up').forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
