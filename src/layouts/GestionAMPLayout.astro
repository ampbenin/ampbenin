---
/**
 * Layout principal de l'espace AMP
 * Utilisé par ADMIN, EC, IS, SUPERVISEUR et PARTENAIRE
 */

import "../styles/tokens.css";
import LogoutButton from "@/components/gestionamp/common/LogoutButton.jsx";

const { title = "AMP BENIN" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
    />
  </head>

  <body>
    <!-- HEADER -->
    <header class="amp-header">
      <div class="logo">
        <strong>AMP BENIN</strong>
        <span class="amp-header__tag">Gestion des espaces</span>
      </div>

      <div class="amp-header__scroll">
        <nav class="amp-nav" id="amp-nav">
          <!-- Rempli côté client selon le rôle connecté (voir script ci-dessous) -->
        </nav>

        <div class="actions">
          <!-- Mode sombre/clair — décision utilisateur, 2026-08-19 : "au
               niveau du header", pour tout l'espace Gestion (pas seulement
               Superviseur). Un seul bouton partagé ici plutôt que dupliqué
               dans chaque tableau de bord — vanilla JS (ce layout n'est pas
               un composant React), même clé localStorage que les pages
               Volontaire (src/hooks/useTheme.js) pour rester cohérent si le
               même navigateur visite les deux. -->
          <button id="amp-theme-toggle" class="amp-theme-toggle" type="button" aria-label="Basculer le mode sombre/clair" title="Mode sombre/clair">🌙</button>
          <!-- Bouton logout React (slot par défaut si la page n'en fournit pas) —
               ne s'affiche que si connecté (voir LogoutButton.jsx). -->
          <slot name="logout">
            <LogoutButton client:load />
          </slot>
        </div>
      </div>
    </header>

    <!-- CONTENU -->
    <main class="amp-content">
      <slot />
    </main>

    <!-- FOOTER SIMPLE -->
    <footer class="amp-footer">
      <small>© AMP BENIN — Plateforme de suivi</small>
    </footer>

    <script is:inline>
      // Navigation adaptée au rôle connecté : chacun ne voit que ce qui le
      // concerne, et un ADMIN retrouve un lien direct vers l'espace CMS
      // (contenu du site), qui reste une interface séparée par choix.
      //
      // Corrigé le 2026-08-19 : SUPERVISEUR et PARTENAIRE tombaient dans le
      // "else" et voyaient un lien "Connexion" alors qu'ils étaient déjà
      // connectés — en même temps que le bouton "Déconnexion" (toujours
      // affiché par défaut, voir LogoutButton.jsx), ce qui donnait deux
      // boutons faisant la même chose ("connexion" ne menant nulle part
      // d'utile pour quelqu'un déjà connecté). "Connexion" n'apparaît
      // maintenant que si aucun rôle connu n'est trouvé (vraiment pas
      // connecté) ; chaque rôle connecté a son propre lien, LogoutButton.jsx
      // se masque lui-même dans ce cas (voir ce fichier).
      (function () {
        const role = localStorage.getItem('amp_role');
        const nav = document.getElementById('amp-nav');
        if (!nav) return;

        const links = [];
        if (role === 'ADMIN') {
          links.push({ href: '/gestionamp/dashboard/admin', label: 'Gestion AMP' });
          links.push({ href: '/admin/dashboard', label: '← Contenu du site (CMS)', accent: true });
        } else if (role === 'EC') {
          links.push({ href: '/gestionamp/dashboard/ec', label: 'Mon espace EC' });
        } else if (role === 'IS') {
          links.push({ href: '/gestionamp/dashboard/is', label: 'Mon espace IS' });
        } else if (role === 'SUPERVISEUR') {
          // Libellé court (comme "Gestion AMP"/"Mon espace EC") : laisse
          // plus de place au bouton Déconnexion sur une seule ligne, voir
          // .amp-header__scroll — le rôle est de toute façon déjà visible
          // dans le titre de la page ("Dashboard — Superviseur").
          links.push({ href: '/gestionamp/dashboard/superviseur', label: 'Espace Superviseur' });
        } else if (role === 'PARTENAIRE') {
          links.push({ href: '/gestionamp/dashboard/partenaire', label: 'Espace Partenaire' });
        } else {
          links.push({ href: '/gestionamp/login', label: 'Connexion' });
        }

        nav.innerHTML = links
          .map((l) => `<a href="${l.href}"${l.accent ? ' class="amp-nav__accent"' : ''}>${l.label}</a>`)
          .join('');
      })();
    </script>

    <script is:inline>
      // Mode sombre/clair partagé par tout l'espace Gestion (décision
      // utilisateur, 2026-08-19) — pose data-theme sur <body>, lu par le
      // <style is:global> ci-dessous ET par Tailwind (darkMode: ["selector",
      // '[data-theme="dark"]'], voir tailwind.config.js), donc valable aussi
      // pour les composants React qui utilisent des classes dark:.
      (function () {
        const STORAGE_KEY = 'amp_dashboard_theme';
        const btn = document.getElementById('amp-theme-toggle');

        const apply = (theme) => {
          document.body.setAttribute('data-theme', theme);
          if (btn) btn.textContent = theme === 'dark' ? '☀️' : '🌙';
        };

        let stored = localStorage.getItem(STORAGE_KEY);
        if (stored !== 'light' && stored !== 'dark') {
          stored = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        apply(stored);

        btn?.addEventListener('click', () => {
          const next = document.body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          localStorage.setItem(STORAGE_KEY, next);
          apply(next);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* ═══════════════════════════════════════════════
     Espace Gestion AMP — habillage partagé
     (ADMIN, EC, IS, SUPERVISEUR, PARTENAIRE)
     Réutilise les tokens de marque du site public
     (src/styles/tokens.css) : vert forêt + or ambré.
     ═══════════════════════════════════════════════ */

  body {
    margin: 0;
    font-family: var(--font-body);
    background: var(--col-bg);
    color: var(--col-text);
    transition: background 0.2s ease, color 0.2s ease;
  }

  /* Mode sombre — décision utilisateur, 2026-08-19 : tout l'espace Gestion
     (ADMIN/EC/IS/SUPERVISEUR/PARTENAIRE), pas seulement des div/sections
     isolées. Redéfinit les tokens var(--col-*) déjà utilisés dans TOUT ce
     fichier — la quasi-totalité du CSS partagé (en-tête, tableaux, cartes,
     formulaires, badges de statut...) s'adapte donc automatiquement, sans
     retouche par ailleurs. --col-white et --col-primary-dark sont
     volontairement JAMAIS redéfinis ici : ils servent aussi de "texte
     blanc sur bouton coloré" (.dashboard-section button) et de fond
     toujours-vert-foncé du bandeau (.amp-header, .amp-nav__accent), qui ne
     doivent jamais dépendre du thème — leurs 3 seuls usages comme texte de
     PAGE (dashboard-header h1 / dashboard-section h3 / filter-bar h2) sont
     corrigés séparément juste en dessous, ciblés.
     Les composants React écrits en Tailwind (classes bg-white,
     text-gray-700...) ne sont PAS concernés par ces variables — voir
     tailwind.config.js (darkMode par attribut) : ils demandent des classes
     dark: ajoutées fichier par fichier, à venir progressivement. */
  body[data-theme="dark"] {
    --col-bg: #0F1A14;
    --col-surface: #16241C;
    --col-surface2: #1E3226;
    --col-border: #2A4234;
    --col-border-light: #22362A;
    --col-text: #F0EDE6;
    --col-text-sec: #C7C2B8;
    --col-text-muted: #9CA89C;
    --col-primary: #74C69D;
    --col-primary-light: #74C69D;
    --col-primary-bg: #16281F;
    --col-accent-bg: rgba(201, 144, 58, 0.18);
    --col-accent-dark: #E8C47A;
    --col-success: #4ade80;
    --col-success-bg: rgba(34, 197, 94, 0.18);
    --col-error: #f87171;
    --col-error-bg: rgba(239, 68, 68, 0.18);
  }
  body[data-theme="dark"] .dashboard-section,
  body[data-theme="dark"] .dashboard-section input,
  body[data-theme="dark"] .dashboard-section select,
  body[data-theme="dark"] .dashboard-section textarea {
    background: var(--col-surface);
  }
  body[data-theme="dark"] .dashboard-header h1,
  body[data-theme="dark"] .dashboard-section h3,
  body[data-theme="dark"] .filter-bar h2 {
    color: var(--col-primary-light);
  }

  /* ── En-tête ── */
  /* Une seule ligne, jamais un retour à la ligne (décision utilisateur,
     2026-08-19) — s'il n'y a vraiment pas la place (mobile très étroit),
     on défile horizontalement plutôt que de casser sur 2 lignes : le
     logo/tag ne rétrécissent jamais eux, seuls nav+actions peuvent
     scroller (voir .amp-header__scroll ci-dessous). */
  .amp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-8);
    background: var(--col-primary-dark);
    color: var(--col-text-inverted);
  }

  .amp-header__scroll {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .amp-header .logo {
    flex-shrink: 0;
  }

  .amp-header .logo strong {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    letter-spacing: 0.02em;
  }

  .amp-header__tag {
    display: block;
    font-size: var(--text-xs);
    opacity: 0.65;
    font-weight: 400;
  }

  .amp-nav {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: nowrap;
    flex-shrink: 0;
  }

  .amp-nav a {
    color: var(--col-text-inverted);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: 0.4rem 0.75rem;
    border-radius: var(--r-sm);
    white-space: nowrap;
    transition: background var(--tr-fast);
  }

  .amp-nav a:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .amp-nav__accent {
    background: var(--col-accent);
    color: var(--col-primary-dark) !important;
    font-weight: 600;
  }

  .amp-nav__accent:hover {
    background: var(--col-accent-light) !important;
  }

  .amp-header .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
  }

  .amp-header .actions button {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: var(--col-text-inverted);
    padding: 0.45rem 1rem;
    border-radius: var(--r-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition: background var(--tr-fast), border-color var(--tr-fast);
    float: none !important;
  }

  .amp-header .actions button:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.6);
  }

  .amp-theme-toggle {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    border-radius: 999px !important;
  }

  /* ── Contenu ── */
  .amp-content {
    padding: var(--sp-8);
    max-width: 1280px;
    margin: 0 auto;
  }

  /* ── Pied de page ── */
  .amp-footer {
    text-align: center;
    padding: var(--sp-4);
    background: var(--col-surface2);
    color: var(--col-text-muted);
    font-size: var(--text-xs);
  }

  /* ═══════════════════════════════════════════════
     Dashboards (ADMIN/EC/IS/SUPERVISEUR/PARTENAIRE) —
     classes communes rendues par les composants React
     (client:load), donc stylées ici en global plutôt
     que dans le <style> scopé de chaque page .astro.
     ═══════════════════════════════════════════════ */

  .dashboard {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .dashboard-header {
    padding-bottom: var(--sp-5);
    border-bottom: 2px solid var(--col-border);
  }

  .dashboard-header h1 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--col-primary-dark);
    margin: 0 0 var(--sp-2);
  }

  .dashboard-header p {
    color: var(--col-text-muted);
    margin: 0;
    font-size: var(--text-base);
  }

  .dashboard-section {
    background: var(--col-white);
    border: 1px solid var(--col-border-light);
    border-radius: var(--r-lg);
    padding: var(--sp-6) var(--sp-8);
    box-shadow: var(--sh-xs);
  }

  .dashboard-section > h2 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--col-primary);
    margin: 0 0 var(--sp-5);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--col-border-light);
  }

  .dashboard-section > h2:not(:first-child) {
    margin-top: var(--sp-8);
  }

  .dashboard-section h3 {
    font-family: var(--font-heading);
    color: var(--col-primary-dark);
  }

  /* ── Cartes de statistiques ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--sp-4);
  }

  .stat-card {
    background: var(--col-primary-bg);
    border: 1px solid var(--col-border-light);
    border-radius: var(--r-md);
    padding: var(--sp-5);
    text-align: center;
    transition: transform var(--tr-fast), box-shadow var(--tr-fast);
  }

  .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--sh-sm);
  }

  .stat-card h3 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--col-text-sec);
    margin: 0 0 var(--sp-2);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .stat-card p {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--col-primary);
    margin: 0;
  }

  /* ── Cartes financières ── */
  .finance-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-4);
  }

  .finance-card {
    border-radius: var(--r-md);
    padding: var(--sp-5);
    text-align: center;
    border: 1px solid var(--col-border-light);
  }

  .finance-card h3 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--col-text-sec);
    margin: 0 0 var(--sp-2);
    font-weight: 500;
  }

  .finance-card p {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: 0;
  }

  .finance-card.income { background: var(--col-success-bg); }
  .finance-card.income p { color: var(--col-success); }
  .finance-card.expense { background: var(--col-error-bg); }
  .finance-card.expense p { color: var(--col-error); }
  .finance-card.balance { background: var(--col-accent-bg); }
  .finance-card.balance p { color: var(--col-accent-dark); }

  /* ── Formulaires ── */
  .dashboard-section form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: flex-end;
    margin-bottom: var(--sp-6);
  }

  .dashboard-section label {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    font-size: var(--text-sm);
    color: var(--col-text-sec);
    font-weight: 500;
    flex: 1 1 200px;
  }

  .dashboard-section input,
  .dashboard-section select,
  .dashboard-section textarea {
    padding: 0.55rem var(--sp-3);
    border: 1px solid var(--col-border);
    border-radius: var(--r-sm);
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--col-text);
    background: var(--col-white);
    transition: border-color var(--tr-fast), box-shadow var(--tr-fast);
  }

  .dashboard-section input:focus,
  .dashboard-section select:focus,
  .dashboard-section textarea:focus {
    outline: none;
    border-color: var(--col-primary-light);
    box-shadow: 0 0 0 3px var(--col-primary-bg);
  }

  /* ── Boutons ── */
  .dashboard-section button {
    padding: 0.55rem var(--sp-5);
    border-radius: var(--r-sm);
    border: none;
    background: var(--col-primary);
    color: var(--col-white);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background var(--tr-fast);
    white-space: nowrap;
  }

  .dashboard-section button:hover:not(:disabled) {
    background: var(--col-primary-light);
  }

  .dashboard-section button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .dashboard-section button.danger {
    background: var(--col-error);
  }

  .dashboard-section button.danger:hover:not(:disabled) {
    background: #96101c;
  }

  /* Bouton secondaire (ex : "Annuler" dans SpacesManager) */
  .dashboard-section button[type="button"]:not(.danger) {
    background: transparent;
    color: var(--col-text-sec);
    border: 1px solid var(--col-border);
  }

  .dashboard-section button[type="button"]:not(.danger):hover {
    background: var(--col-surface);
  }

  /* ── Tableaux ── */
  .dashboard-section table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .dashboard-section thead th {
    text-align: left;
    padding: var(--sp-3) var(--sp-4);
    background: var(--col-surface);
    color: var(--col-text-sec);
    font-weight: 600;
    text-transform: uppercase;
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    border-bottom: 2px solid var(--col-border);
  }

  .dashboard-section tbody td {
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--col-border-light);
    color: var(--col-text);
    vertical-align: middle;
  }

  .dashboard-section tbody tr:hover {
    background: var(--col-primary-bg);
  }

  .dashboard-section tbody tr:last-child td {
    border-bottom: none;
  }

  .dashboard-section td.actions {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  /* ── Badges de statut ── */
  .status {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: var(--r-full);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: capitalize;
    background: var(--col-surface2);
    color: var(--col-text-sec);
  }

  .status.active,
  .status.validée,
  .status.validee,
  .status.réalisée,
  .status.realisee,
  .status.approved {
    background: var(--col-success-bg);
    color: var(--col-success);
  }

  .status.inactive,
  .status.rejetée,
  .status.rejetee,
  .status.refusée,
  .status.refusee,
  .status.rejected {
    background: var(--col-error-bg);
    color: var(--col-error);
  }

  .status.pending,
  .status.planifiée,
  .status.planifiee,
  .status.en-attente {
    background: var(--col-accent-bg);
    color: var(--col-accent-dark);
  }

  /* ── Barre de filtres ── */
  .filter-bar {
    background: var(--col-surface);
    border-radius: var(--r-md);
    padding: var(--sp-5);
  }

  .filter-bar h2 {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--col-primary-dark);
    margin: 0 0 var(--sp-4);
    border: none !important;
    padding: 0 !important;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
  }

  .filter {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .filter label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--col-text-sec);
  }

  /* ── États ── */
  .error {
    color: var(--col-error);
    background: var(--col-error-bg);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-sm);
    font-size: var(--text-sm);
  }

  .spaces-manager__error {
    color: var(--col-error);
    background: var(--col-error-bg);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-sm);
    font-size: var(--text-sm);
    flex-basis: 100%;
  }

  .dashboard-section > p,
  .dashboard-section p:only-child {
    color: var(--col-text-muted);
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .amp-header {
      padding: var(--sp-3) var(--sp-4);
    }

    /* Reste sur une seule ligne (voir .amp-header ci-dessus) — resserré
       pour laisser le plus de place possible avant que .amp-header__scroll
       ne doive défiler horizontalement. */
    .amp-header__tag {
      display: none;
    }

    .amp-nav a {
      padding: 0.35rem 0.5rem;
      font-size: var(--text-xs);
    }

    .amp-header .logo strong {
      font-size: var(--text-lg);
    }

    .amp-header__scroll {
      gap: var(--sp-2);
    }

    .amp-header .actions {
      gap: var(--sp-1);
    }

    .amp-header .actions button {
      padding: 0.4rem 0.7rem;
      font-size: var(--text-xs);
    }

    .amp-content {
      padding: var(--sp-4);
    }

    .dashboard-section {
      padding: var(--sp-5);
