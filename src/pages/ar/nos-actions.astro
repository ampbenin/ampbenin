---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NosActions from "../../components/NosActions.jsx";
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  title={t('meta', 'actionsTitle')}
  description={t('meta', 'actionsDesc')}
  url={Astro.url.href}
  keywords="actions AMP BENIN, projets VBG, SSR Bénin, mobilisation citoyenne, autonomisation femmes, jeunes"
>
  <script type="application/ld+json" slot="head">
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"الرئيسية","item":"https://ampbenin.netlify.app/ar"},{"@type":"ListItem","position":2,"name":"أعمالنا","item":"https://ampbenin.netlify.app/ar/nos-actions"}]}
  </script>
  <NosActions client:visible />
</BaseLayout>
