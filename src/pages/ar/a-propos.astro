---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  title={t('about', 'title')}
  description={t('meta', 'aboutDesc')}
  url={Astro.url.href}
  keywords="AMP BENIN تاريخ، رسالة منظمة بنين، رؤية التنمية المستدامة"
>
  <script type="application/ld+json" slot="head">
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"الرئيسية","item":"https://ampbenin.netlify.app/ar"},{"@type":"ListItem","position":2,"name":"من نحن","item":"https://ampbenin.netlify.app/ar/a-propos"}]}
  </script>

  <section class="bg-white text-gray-800 py-12 px-4 md:px-12">
    <div class="max-w-5xl mx-auto text-center">
      <h1 class="text-4xl font-bold mb-4 text-primary">{t('about', 'title')}</h1>
      <p class="text-lg mb-6 text-gray-700">{t('about', 'intro')}</p>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold mb-2 text-primary">{t('about', 'visionTitle')}</h2>
        <p class="text-gray-700">{t('about', 'visionText')}</p>
      </div>
      <div>
        <h2 class="text-2xl font-semibold mb-2 text-primary">{t('about', 'missionTitle')}</h2>
        <p class="text-gray-700">{t('about', 'missionText')}</p>
      </div>
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-semibold mb-4 text-center text-primary">{t('about', 'valuesTitle')}</h2>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <li class="bg-gray-100 p-6 rounded-xl shadow-sm hover:shadow-md transition">
          <strong class="text-primary">{t('about', 'value1Title')}</strong><br />
          <span class="text-gray-700">{t('about', 'value1Desc')}</span>
        </li>
        <li class="bg-gray-100 p-6 rounded-xl shadow-sm hover:shadow-md transition">
          <strong class="text-primary">{t('about', 'value2Title')}</strong><br />
          <span class="text-gray-700">{t('about', 'value2Desc')}</span>
        </li>
        <li class="bg-gray-100 p-6 rounded-xl shadow-sm hover:shadow-md transition">
          <strong class="text-primary">{t('about', 'value3Title')}</strong><br />
          <span class="text-gray-700">{t('about', 'value3Desc')}</span>
        </li>
      </ul>
    </div>

    <div class="mt-16 text-center">
      <h2 class="text-2xl font-semibold mb-4 text-primary">{t('about', 'historyTitle')}</h2>
      <p class="max-w-3xl mx-auto text-gray-700">{t('about', 'historyText')}</p>
    </div>

    <div class="mt-16 text-center">
      <h2 class="text-2xl font-semibold mb-4 text-primary">{t('about', 'commitTitle')}</h2>
      <p class="max-w-3xl mx-auto text-gray-700">{t('about', 'commitText')}</p>
    </div>
  </section>
</BaseLayout>
