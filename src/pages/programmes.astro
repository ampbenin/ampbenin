---
import Layout from '../layouts/BaseLayout.astro';
import { useTranslations, resolveLang } from '../i18n/utils';
const lang = resolveLang(Astro);
const t = useTranslations(lang);

// Contenu géré depuis le CMS admin (/admin/dashboard → Programmes),
// avec repli sur les 4 cartes codées en dur si l'API est indisponible.
const FALLBACK_PROGRAMMES = [
  {
    slug: 'campagne-paix',
    title: '🕊️ Campagne nationale pour la paix',
    description: "Initiative de mobilisation en ligne pour la cohésion sociale, la lutte contre la désinformation et la radicalisation, lancée à l'occasion du 1er août.\n\nPériode : Juillet - Août 2025",
  },
  {
    slug: 'education-leadership-jeunesse',
    title: '🎓 Éducation et leadership jeunesse',
    description: "Formations, clubs scolaires et mentorat pour éveiller les jeunes à l'engagement citoyen et à la réalisation des Objectifs de Développement Durable (ODD).\n\nEn cours dans plusieurs établissements",
  },
  {
    slug: 'sante-bien-etre',
    title: '👩🏾‍⚕️ Santé et bien-être',
    description: "Sensibilisation sur les violences basées sur le genre (VBG), la santé mentale, les droits sexuels et reproductifs, avec accompagnement communautaire.\n\nEn partenariat avec des ONG locales",
  },
  {
    slug: 'innovation-developpement-durable',
    title: '🌱 Innovation & développement durable',
    description: "Projets numériques, écologiques et entrepreneuriaux portés par les jeunes pour accélérer la mise en œuvre des ODD dans les communautés.\n\nProjets pilotes en cours",
  },
];

let programmes = FALLBACK_PROGRAMMES;
try {
  const apiBase = import.meta.env.PUBLIC_API_BASE || '';
  const res = await fetch(`${apiBase}/api/cms/programmes`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data?.items) && data.items.length > 0) {
      programmes = data.items;
    }
  }
} catch {
  // API indisponible → on garde le repli.
}
---

<Layout
  title={t('meta', 'programmesTitle')}
  description={t('meta', 'programmesDesc')}
  url="https://ampbenin.netlify.app/programmes"
  keywords="programmes AMP BENIN, campagne paix Bénin, leadership jeunesse, ODD Bénin, développement durable"
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://ampbenin.netlify.app" },
      { "@type": "ListItem", "position": 2, "name": "Nos Programmes", "item": "https://ampbenin.netlify.app/programmes" }
    ]
  }
  </script>

  <section class="prog-head section-py">
    <div class="container">
      <div class="prog-head__inner fade-up">
        <span class="section-label section-label--green">Nos programmes</span>
        <h1 class="prog-head__title">Des actions concrètes, portées par la communauté</h1>
        <p class="prog-head__subtitle">
          AMP BENIN développe des programmes d'action concrets pour un monde plus juste, durable et pacifique.
        </p>
      </div>
    </div>
  </section>

  <section class="prog-list section-py">
    <div class="container">
      <div class="prog-grid">
        {programmes.map((p, i) => {
          const [main, note] = p.description.split('\n\n');
          return (
            <article class="prog-card fade-up" style={`transition-delay:${(i % 2) * 0.1}s`}>
              {p.image ? (
                <div class="prog-card__img-wrap">
                  <img
                    src={p.image}
                    alt={p.title}
                    class="prog-card__img"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <span class="prog-card__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              )}
              <div class="prog-card__body">
                <h2 class="prog-card__title">{p.title}</h2>
                <p class="prog-card__desc">{main}</p>
                {note && <span class="prog-card__note">{note}</span>}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

</Layout>

<style>
  .prog-head { background: var(--col-surface); }
  .prog-head__inner {
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
  .prog-head__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    color: var(--col-primary);
    line-height: 1.15;
    margin-bottom: var(--sp-4);
  }
  .prog-head__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--col-text-sec);
    line-height: 1.7;
  }

  .prog-list { background: var(--col-bg); }
  .prog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }
  @media (min-width: 768px) {
    .prog-grid { grid-template-columns: repeat(2, 1fr); gap: var(--sp-10); }
  }

  .prog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--col-white);
    border: 1px solid var(--col-border-light);
    border-radius: var(--r-2xl);
    overflow: hidden;
    box-shadow: var(--sh-sm);
    transition: transform var(--tr-base), box-shadow var(--tr-base);
  }
  .prog-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--sh-lg);
  }

  .prog-card__img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--col-primary-dark);
  }
  .prog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--tr-slow);
  }
  .prog-card:hover .prog-card__img { transform: scale(1.06); }

  .prog-card__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin: var(--sp-6) var(--sp-6) 0;
    background: var(--col-primary-bg);
    color: var(--col-primary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    border-radius: var(--r-full);
  }

  .prog-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--sp-6);
  }
  .prog-card__num + .prog-card__body { padding-top: var(--sp-4); }

  .prog-card__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--col-primary);
    line-height: 1.3;
    margin-bottom: var(--sp-3);
  }
  .prog-card__desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--col-text-sec);
    line-height: 1.7;
    flex: 1;
    margin-bottom: var(--sp-4);
  }
  .prog-card__note {
    display: inline-block;
    align-self: flex-start;
    background: var(--col-accent-bg);
    color: var(--col-accent-xdark);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-full);
  }
</style>
