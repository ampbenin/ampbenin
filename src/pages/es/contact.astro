---
import Layout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
const prefix = lang === 'fr' ? '' : `/${lang}`;
---

<Layout
  title={t('meta', 'contactTitle')}
  description={t('meta', 'contactDesc')}
  url={Astro.url.href}
  keywords="contact AMP BENIN, partenariat ONG Bénin, adhésion, volontariat, Tori-Bossito"
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://ampbenin.netlify.app" },
      { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://ampbenin.netlify.app/contact" }
    ]
  }
  </script>

  <section class="py-12 px-6 md:px-20 bg-gray-50 text-gray-800" aria-labelledby="contact-title">
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h1 id="contact-title" class="text-4xl font-bold text-primary mb-4">{t('contact', 'title')}</h1>
      <p class="text-lg text-gray-600">{t('contact', 'subtitle')}</p>
    </div>

    <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8 text-center">

      <div class="p-6 bg-white rounded-2xl shadow hover:shadow-md transition">
        <div class="flex justify-center mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M14 12l2 2m0 0l4-4m-4 4l-4 4m4-4l-4-4m6-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold mb-2">{t('contact', 'partnerTitle')}</h3>
        <p class="text-sm text-gray-600 mb-4">{t('contact', 'partnerDesc')}</p>
        <a href={`${prefix}/partenaire`} class="inline-block bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition">
          {t('contact', 'partnerBtn')}
        </a>
      </div>

      <div class="p-6 bg-white rounded-2xl shadow hover:shadow-md transition">
        <div class="flex justify-center mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M15 11a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold mb-2">{t('contact', 'memberTitle')}</h3>
        <p class="text-sm text-gray-600 mb-4">{t('contact', 'memberDesc')}</p>
        <a href={`${prefix}/adhesion`} class="inline-block bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition">
          {t('contact', 'memberBtn')}
        </a>
      </div>

      <div class="p-6 bg-white rounded-2xl shadow hover:shadow-md transition">
        <div class="flex justify-center mb-4 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 21l-1-1c-4.5-4.5-6-6-6-9a5 5 0 0110 0c0 3-1.5 4.5-6 9l-1 1z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold mb-2">{t('contact', 'volunteerTitle')}</h3>
        <p class="text-sm text-gray-600 mb-4">{t('contact', 'volunteerDesc')}</p>
        <a href={`${prefix}/volontaires`} class="inline-block bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-dark transition">
          {t('contact', 'volunteerBtn')}
        </a>
      </div>

    </div>
  </section>

  <section class="py-16 px-6 md:px-20 bg-white text-gray-800" aria-labelledby="form-title">
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h2 id="form-title" class="text-4xl font-bold text-primary mb-4">{t('contact', 'formTitle')}</h2>
      <p class="text-lg text-gray-600">{t('contact', 'subtitle')}</p>
    </div>

    <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-10">
      <form id="contactForm"
        class="space-y-6 bg-gray-50 p-6 rounded-2xl shadow hover:shadow-md transition"
        data-sending={t('contact', 'formSending')}
        data-error={t('contact', 'formError')}
      >

        <div>
          <label for="name" class="block text-sm font-medium text-gray-700">{t('contact', 'formName')} *</label>
          <input type="text" name="name" id="name" required autocomplete="name"
            class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary" />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-700">{t('contact', 'formEmail')} *</label>
          <input type="email" name="email" id="email" required autocomplete="email"
            class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary" />
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-gray-700">Pays / Ville *</label>
          <input type="text" name="location" id="location" required
            class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary" />
        </div>

        <div>
          <label for="whatsapp" class="block text-sm font-medium text-gray-700">Numéro WhatsApp</label>
          <input type="tel" name="whatsapp" id="whatsapp" placeholder="+229XXXXXXXX" autocomplete="tel"
            class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary" />
        </div>

        <div>
          <label for="destination" class="block text-sm font-medium text-gray-700">Destination de votre message *</label>
          <select name="destination" id="destination" required
            class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary">
            <option value="">-- Sélectionnez --</option>
            <option value="Direction Générale (Conseil d'Administration)">1 - Direction Générale (Conseil d'Administration)</option>
            <option value="Direction Administrative et Financière">2 - Direction Administrative et Financière</option>
            <option value="Direction Exécutive et Technique">3 - Direction Exécutive et Technique</option>
            <option value="Direction des Plaintes et de Régulation (Conseil de Supervision)">4 - Direction des Plaintes et de Régulation (Conseil de Supervision)</option>
            <option value="Institution Spécialisée">5 - Institution Spécialisée</option>
          </select>
        </div>

        <div id="institutionField" class="hidden">
          <label for="institution" class="block text-sm font-medium text-gray-700">Choisissez l'institution spécialisée</label>
          <select name="institution" id="institution"
            class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary">
            <option value="">-- Sélectionnez --</option>
            <option value="Coordination Internationale de Décentralisation et AMP zones">1 - Coordination Internationale de Décentralisation et AMP zones</option>
            <option value="SFPF-AMP">2 - SFPF-AMP - Section du Féminisme et de Promotion de la Femme</option>
            <option value="SEPE-AMP">3 - SEPE-AMP - Section de l'Éducation et de Promotion de l'Enfance</option>
            <option value="SECV AMP">4 - SECV AMP - Section de l'environnement et du climat</option>
            <option value="SCCS-AMP">5 - SCCS-AMP - Section du Citoyenneté et de Cohésion Sociale</option>
            <option value="SNIE-AMP">6 - SNIE-AMP - Section du Numérique, d'Innovation et de l'Entrepreneuriat</option>
            <option value="SBSC-AMP">7 - SBSC-AMP - Section du Bien-être et de Santé Communautaire</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-700">{t('contact', 'formMessage')} *</label>
          <textarea name="message" id="message" rows="5" required
            class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:ring-primary focus:border-primary"></textarea>
        </div>

        <p class="text-xs text-gray-500">
          Vos informations seront traitées en toute confidentialité et utilisées uniquement pour répondre à votre demande.
        </p>

        <button type="submit" class="w-full bg-primary text-white py-2 px-4 rounded-lg hover:bg-primary-dark transition">
          {t('contact', 'formBtn')}
        </button>
      </form>

      <div class="space-y-6 text-gray-700">
        <div>
          <h3 class="text-lg font-semibold text-primary mb-1">Nos contacts</h3>
          <p>Email : <a href="mailto:ampbenin.contact@gmail.com" class="text-blue-600">ampbenin.contact@gmail.com</a></p>
          <p>Téléphone : <span class="text-gray-800 font-medium">+229 01 47 47 14 65</span></p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-primary mb-1">Adresse</h3>
          <p>TORI-BOSSITO, Bénin</p>
          <p>Siège AMP BENIN</p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-primary mb-1">Réseaux sociaux</h3>
          <ul class="space-y-1">
            <li><a href="https://facebook.com/ampbenin.org" class="text-blue-600" target="_blank" rel="noopener noreferrer">Facebook</a></li>
            <li><a href="https://twitter.com" class="text-blue-500" target="_blank" rel="noopener noreferrer">Twitter / X</a></li>
            <li><a href="https://instagram.com" class="text-purple-600" target="_blank" rel="noopener noreferrer">Instagram</a></li>
            <li><a href="https://whatsapp.com/channel/0029VaIOnPDEVccHs3abBh1A" class="text-green-600" target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

<script is:inline>
document.addEventListener("DOMContentLoaded", function () {
  var form = document.getElementById("contactForm");
  var i18nSending = form.dataset.sending || "Envoi en cours…";
  var i18nError   = form.dataset.error   || "Erreur lors de l'envoi. Merci de réessayer.";

  var statusMessage = document.createElement("p");
  statusMessage.className = "mt-4 text-center text-sm";
  form.appendChild(statusMessage);

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    var data = {
      name:        form.name.value.trim(),
      email:       form.email.value.trim(),
      location:    form.location.value.trim(),
      whatsapp:    form.whatsapp.value.trim(),
      destination: form.destination.value,
      institution: form.institution ? form.institution.value : "",
      message:     form.message.value.trim(),
    };
    statusMessage.style.color = "gray";
    statusMessage.textContent = i18nSending;
    try {
      var response = await fetch("https://potential-rafa-amp1-00541efa.koyeb.app/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      var result = await response.json().catch(function () { return null; });
      if (response.ok) {
        statusMessage.style.color = "green";
        statusMessage.textContent = result && result.message ? result.message : "Message envoyé avec succès !";
        form.reset();
      } else {
        statusMessage.style.color = "red";
        statusMessage.textContent = (result && result.message) || i18nError;
      }
    } catch (error) {
      statusMessage.style.color = "red";
      statusMessage.textContent = i18nError;
    }
  });

  var destinationSelect = form.destination;
  var institutionField  = document.getElementById("institutionField");
  destinationSelect.addEventListener("change", function () {
    if (destinationSelect.value === "Institution Spécialisée") {
      institutionField.classList.remove("hidden");
    } else {
      institutionField.classList.add("hidden");
    }
  });
});
</script>

</Layout>
