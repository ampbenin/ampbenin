---
import Layout from '../layouts/BaseLayout.astro';
import { useTranslations, resolveLang } from '../i18n/utils';
const lang = resolveLang(Astro);
const t = useTranslations(lang);

// Catalogue géré depuis l'admin (/admin/dashboard → Programmes de
// volontariat). Remplace l'ancien formulaire générique unique : chaque
// programme publié a désormais sa propre fiche et son propre formulaire de
// candidature (voir server-amp-sites/controllers/volunteerProgramController.js).
let programs = [];
try {
  const apiBase = import.meta.env.PUBLIC_API_BASE || '';
  const res = await fetch(`${apiBase}/api/volunteer-programs`);
  if (res.ok) {
    const data = await res.json();
    programs = Array.isArray(data?.items) ? data.items : [];
  }
} catch {
  // API indisponible → catalogue vide, la page reste utilisable (candidature spontanée toujours possible).
}

const formatDate = (d) => d ? new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : null;
---

<Layout
  title={t('meta', 'volontairesTitle')}
  description={t('meta', 'volontairesDesc')}
  url="https://ampbenin.netlify.app/volontaires"
  keywords="volontaire AMP BENIN, sympathisant ONG Bénin, bénévolat Bénin, engagement citoyen, jeunesse Bénin"
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://ampbenin.netlify.app" },
      { "@type": "ListItem", "position": 2, "name": "Devenir Volontaire", "item": "https://ampbenin.netlify.app/volontaires" }
    ]
  }
  </script>

  <section class="vol-head section-py">
    <div class="container">
      <div class="vol-head__inner fade-up">
        <span class="section-label section-label--green">Volontariat</span>
        <h1 class="vol-head__title">Rejoignez les volontaires AMP BENIN</h1>
        <p class="vol-head__subtitle">
          Parcourez nos programmes ouverts aux candidatures, ou manifestez votre intérêt général —
          notre équipe vous recontactera dès qu'une opportunité correspond à votre profil.
        </p>
        <a href="/volontaires/candidature-spontanee" class="btn btn--accent btn--lg">
          Candidature spontanée →
        </a>
      </div>
    </div>
  </section>

  <section class="vol-list section-py">
    <div class="container">
      <h2 class="vol-list__title fade-up">Programmes ouverts aux candidatures</h2>

      {programs.length === 0 && (
        <p class="vol-list__empty fade-up">
          Aucun programme n'est ouvert aux candidatures pour le moment — mais vous pouvez déjà
          <a href="/volontaires/candidature-spontanee">déposer une candidature spontanée</a>.
        </p>
      )}

      <div class="vol-grid">
        {programs.map((p, i) => (
          <article class="vol-card fade-up" style={`transition-delay:${(i % 3) * 0.1}s`}>
            {p.coverImageUrl ? (
              <div class="vol-card__img-wrap">
                <img src={p.coverImageUrl} alt={p.title} class="vol-card__img" loading="lazy" decoding="async" />
              </div>
            ) : (
              <div class="vol-card__img-wrap vol-card__img-wrap--placeholder" aria-hidden="true">🌍</div>
            )}
            <div class="vol-card__body">
              {p.location && <span class="vol-card__badge">{p.location}</span>}
              <h3 class="vol-card__title">{p.title}</h3>
              {p.description && <p class="vol-card__desc">{p.description}</p>}
              <div class="vol-card__meta">
                {formatDate(p.startDate) && <span>Début : {formatDate(p.startDate)}</span>}
                {formatDate(p.applicationDeadline) && <span>Candidatures jusqu'au {formatDate(p.applicationDeadline)}</span>}
              </div>
              <a href={`/volontaires/candidature/${p._id}`} class="btn btn--primary btn--sm">Postuler →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .vol-head { background: var(--col-surface); }
  .vol-head__inner {
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .vol-head__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    color: var(--col-primary);
    line-height: 1.15;
    margin-bottom: var(--sp-4);
  }
  .vol-head__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--col-text-sec);
    line-height: 1.7;
    margin-bottom: var(--sp-7);
  }

  .vol-list { background: var(--col-bg); }
  .vol-list__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-2xl);
    color: var(--col-primary);
    margin-bottom: var(--sp-8);
  }
  .vol-list__empty { color: var(--col-text-muted); }
  .vol-list__empty a { color: var(--col-accent); font-weight: 600; }

  .vol-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }
  @media (min-width: 640px) { .vol-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .vol-grid { grid-template-columns: repeat(3, 1fr); } }

  .vol-card {
    display: flex;
    flex-direction: column;
    background: var(--col-white);
    border: 1px solid var(--col-border-light);
    border-radius: var(--r-2xl);
    overflow: hidden;
    box-shadow: var(--sh-sm);
    transition: transform var(--tr-base), box-shadow var(--tr-base);
  }
  .vol-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--sh-lg);
  }

  .vol-card__img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--col-primary-dark);
  }
  .vol-card__img-wrap--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }
  .vol-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--tr-slow);
  }
  .vol-card:hover .vol-card__img { transform: scale(1.06); }

  .vol-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: var(--sp-6);
  }
  .vol-card__badge {
    display: inline-block;
    background: var(--col-accent-bg);
    color: var(--col-accent-xdark);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-full);
    margin-bottom: var(--sp-3);
  }
  .vol-card__title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--col-primary);
    line-height: 1.3;
    margin-bottom: var(--sp-3);
  }
  .vol-card__desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--col-text-sec);
    line-height: 1.6;
    margin-bottom: var(--sp-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .vol-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    font-size: var(--text-xs);
    color: var(--col-text-muted);
    margin-bottom: var(--sp-5);
  }
  .vol-card__body .btn { margin-top: auto; }
</style>
