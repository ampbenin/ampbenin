---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import BadgeGenerator from "../../components/badge/BadgeGenerator.jsx";

const { slug } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_BASE || "";

let campaign = null;
try {
  const res = await fetch(`${apiBase}/api/cms/badge-campaigns/public/${slug}`);
  if (res.ok) campaign = await res.json();
} catch {
  campaign = null;
}

if (!campaign) {
  Astro.response.status = 404;
}
---

<BaseLayout title={campaign ? `${campaign.title} | Badge AMP BENIN` : "Campagne introuvable | AMP BENIN"}>
  <main class="min-h-screen bg-gray-50" style={campaign ? `--badge-accent: ${campaign.colors?.accent || "#1B4332"};` : undefined}>
    {campaign ? (
      <>
        {campaign.bannerUrl && (
          <img src={campaign.bannerUrl} alt="" class="w-full max-h-72 object-cover" />
        )}
        <div class="max-w-3xl mx-auto py-10 px-4">
          <h1 class="text-3xl font-bold mb-3" style="color: var(--badge-accent);">{campaign.title}</h1>
          {campaign.description && (
            <p class="text-gray-700 mb-8 whitespace-pre-line">{campaign.description}</p>
          )}
          <BadgeGenerator client:load campaign={campaign} />
        </div>
        {campaign.partners?.length > 0 && (
          <section class="bg-white border-t py-10 px-4">
            <div class="max-w-3xl mx-auto">
              <h2 class="text-xl font-bold mb-6 text-center" style="color: var(--badge-accent);">Ils s'engagent avec nous</h2>
              <ul class="flex flex-wrap justify-center items-center gap-8">
                {campaign.partners.map((p) => (
                  <li class="text-center">
                    {p.websiteUrl ? (
                      <a href={p.websiteUrl} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 hover:opacity-80">
                        {p.logoUrl && <img src={p.logoUrl} alt={p.name} class="h-14 max-w-[160px] object-contain" />}
                        <span class="text-sm text-gray-800">{p.name}</span>
                      </a>
                    ) : (
                      <div class="flex flex-col items-center gap-2">
                        {p.logoUrl && <img src={p.logoUrl} alt={p.name} class="h-14 max-w-[160px] object-contain" />}
                        <span class="text-sm text-gray-800">{p.name}</span>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="max-w-xl mx-auto text-center">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Campagne introuvable</h1>
        <p class="text-gray-600">Ce badge n'existe pas ou n'est pas encore disponible.</p>
      </div>
    )}
  </main>
</BaseLayout>
