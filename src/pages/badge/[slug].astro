---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import BadgeGenerator from "../../components/badge/BadgeGenerator.jsx";
import BadgePartnerJoin from "../../components/badge/BadgePartnerJoin.jsx";
import PartnerItem from "../../components/badge/PartnerItem.astro";

const { slug } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_BASE || "";

let campaign = null;
try {
  const res = await fetch(`${apiBase}/api/cms/badge-campaigns/public/${slug}`);
  if (res.ok) campaign = await res.json();
} catch {
  campaign = null;
}

if (!campaign) {
  Astro.response.status = 404;
}
---

<BaseLayout title={campaign ? `${campaign.title} | Badge AMP BENIN` : "Campagne introuvable | AMP BENIN"}>
  <div class="min-h-screen w-full max-w-full overflow-x-hidden bg-gray-50" style={campaign ? `--badge-accent: ${campaign.colors?.accent || "#1B4332"};` : undefined}>
    {campaign ? (
      <>
        {campaign.bannerUrl && (
          <img src={campaign.bannerUrl} alt="" class="block w-full max-w-full h-auto max-h-72 object-cover" />
        )}
        <div class="w-full max-w-3xl mx-auto py-8 px-4 box-border">
          <h1 class="text-2xl sm:text-3xl font-bold mb-3 break-words" style="color: var(--badge-accent);">{campaign.title}</h1>
          {campaign.description && (
            <p class="text-gray-700 mb-8 whitespace-pre-line break-words">{campaign.description}</p>
          )}
          <BadgeGenerator client:load campaign={campaign} />
        </div>
        {campaign.partners?.length > 0 && (
          <section class="bg-white border-t py-10">
            <div class="max-w-3xl mx-auto px-4">
              <h2 class="text-xl font-bold mb-6 text-center" style="color: var(--badge-accent);">Ils s'engagent avec nous</h2>
            </div>
            <div class="badge-marquee-viewport overflow-hidden">
              <ul class="badge-marquee flex flex-nowrap items-center">
                {[0, 1].map((copy) => (
                  <li class="flex flex-nowrap items-center" aria-hidden={copy === 1 ? "true" : undefined}>
                    {campaign.partners.map((p) => (
                      <div class="mr-8 shrink-0">

                        <PartnerItem partner={p} />

                      </div>
                    ))}
                  </li>
                ))}
              </ul>
            </div>
            <div class="text-center mt-8">
              <a href={`/badge/partenaires/${campaign.slug}`} class="inline-block border-2 px-6 py-2 rounded-xl font-semibold hover:opacity-80" style="border-color: var(--badge-accent); color: var(--badge-accent);">
                Voir tous les partenaires
              </a>
            </div>
          </section>
        )}
        <section class="bg-gray-50 border-t py-10 px-4">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-xl font-bold mb-2 text-center" style="color: var(--badge-accent);">Rejoindre la campagne</h2>
            <p class="text-gray-600 text-center mb-6">Vous êtes une structure ou un particulier et souhaitez vous engager ? Envoyez-nous votre demande.</p>
            <BadgePartnerJoin client:load slug={campaign.slug} />
          </div>
        </section>
      </>
    ) : (
      <div class="max-w-xl mx-auto text-center">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Campagne introuvable</h1>
        <p class="text-gray-600">Ce badge n'existe pas ou n'est pas encore disponible.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .badge-marquee {
    width: max-content;
    animation: badge-marquee 30s linear infinite;
  }
  .badge-marquee-viewport:hover .badge-marquee {
    animation-play-state: paused;
  }
  @keyframes badge-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-marquee { animation: none; }
    .badge-marquee-viewport { overflow-x: auto; }
  }
</style>
