---
export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import PartnerItem from "../../../components/badge/PartnerItem.astro";

const { slug } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_BASE || "";

let campaign = null;
try {
  const res = await fetch(`${apiBase}/api/cms/badge-campaigns/public/${slug}`);
  if (res.ok) campaign = await res.json();
} catch {
  campaign = null;
}

if (!campaign) {
  Astro.response.status = 404;
}
---

<BaseLayout title={campaign ? `Partenaires — ${campaign.title} | AMP BENIN` : "Campagne introuvable | AMP BENIN"}>
  <div class="min-h-screen w-full max-w-full overflow-x-hidden bg-gray-50" style={campaign ? `--badge-accent: ${campaign.colors?.accent || "#1B4332"};` : undefined}>
    {campaign ? (
      <div class="w-full max-w-3xl mx-auto py-8 px-4 box-border">
        <a href={`/badge/${campaign.slug}`} class="text-sm underline text-gray-600">← Retour à la campagne</a>
        <h1 class="text-2xl sm:text-3xl font-bold mt-4 mb-2 break-words" style="color: var(--badge-accent);">Nos partenaires</h1>
        <p class="text-gray-700 mb-8 break-words">{campaign.title}</p>

        {campaign.partners?.length > 0 ? (
          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-6 justify-items-center">
            {campaign.partners.map((p) => (
              <li class="w-full flex justify-center">
                <PartnerItem partner={p} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-600">Aucun partenaire pour le moment.</p>
        )}
      </div>
    ) : (
      <div class="max-w-xl mx-auto text-center py-16 px-4">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Campagne introuvable</h1>
        <p class="text-gray-600">Ce badge n'existe pas ou n'est pas encore disponible.</p>
      </div>
    )}
  </div>
</BaseLayout>
