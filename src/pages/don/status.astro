---
export const prerender = false;
import Layout from '../../layouts/BaseLayout.astro';
import DonationStatus from '../../components/DonationStatus.jsx';

// URL de callback FedaPay fixe (configurée côté backend, ne pas renommer
// sans prévenir) : ?status=approved&id=<transactionId>&close=<true|false>.
// Voir src/components/DonationStatus.jsx pour la logique de suivi.
const params = Astro.url.searchParams;
const status = params.get('status');
const transactionId = params.get('id');
const close = params.get('close');
---

<Layout
  title="Statut de votre don — AMP BENIN"
  description="Suivi du statut de votre don à AMP BENIN après paiement."
  url="https://ampbenin.netlify.app/don/status"
>
  <section class="don-status-section section-py">
    <div class="container">
      <DonationStatus status={status} transactionId={transactionId} close={close} client:load />
    </div>
  </section>
</Layout>

<style>
  .don-status-section {
    display: flex;
    align-items: center;
    min-height: 60vh;
  }
</style>
