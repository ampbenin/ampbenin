---
import { IS_LIST as IS_LIST_FALLBACK } from '../../data/is.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, resolveLang } from '../../i18n/utils';
const lang = resolveLang(Astro);
const t = useTranslations(lang);

// Contenu géré depuis le CMS admin (/admin/dashboard → Institutions Spécialisées),
// avec repli sur les données codées en dur si l'API est indisponible.
let IS_LIST = IS_LIST_FALLBACK;
try {
  const apiBase = import.meta.env.PUBLIC_API_BASE || '';
  const res = await fetch(`${apiBase}/api/cms/institutions`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data?.items) && data.items.length > 0) {
      IS_LIST = data.items;
    }
  }
} catch {
  // API indisponible → on garde le repli.
}
---

<BaseLayout
  title={t('meta', 'isTitle')}
  description={t('meta', 'isDesc')}
  url={Astro.url.href}
  keywords="institutions spécialisées AMP BENIN, SFPF, SEPE, SPEA, SNIE, SCCS, SBSC, ONG Bénin"
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://ampbenin.netlify.app" },
      { "@type": "ListItem", "position": 2, "name": "Institutions Spécialisées", "item": "https://ampbenin.netlify.app/is" }
    ]
  }
  </script>

  <section class="is-head section-py">
    <div class="container">
      <div class="is-head__inner fade-up">
        <span class="section-label section-label--green">Nos divisions</span>
        <h1 class="is-head__title">{t('institutions', 'title')}</h1>
        <p class="is-head__subtitle">{t('institutions', 'subtitle')}</p>
      </div>
    </div>
  </section>

  <section class="is-list section-py">
    <div class="container">
      <div class="is-grid">
        {IS_LIST.map((institution, i) => (
          <a
            href={`/is/${institution.slug}`}
            class="is-page-card fade-up"
            style={`transition-delay:${(i % 3) * 0.1}s`}
            aria-label={`Voir la page de ${institution.name}`}
          >
            <div class="is-page-card__img-wrap">
              <img
                src={institution.image}
                alt={`${institution.name} — Institution Spécialisée AMP BENIN`}
                class="is-page-card__img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="is-page-card__body">
              <h2 class="is-page-card__name">{institution.name}</h2>
              <p class="is-page-card__desc">{institution.description}</p>
              <span class="is-page-card__cta">{t('institutions', 'learnMore')} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .is-head { background: var(--col-surface); }
  .is-head__inner {
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
  .is-head__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    color: var(--col-primary);
    line-height: 1.15;
    margin-bottom: var(--sp-4);
  }
  .is-head__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--col-text-sec);
    line-height: 1.7;
  }

  .is-list { background: var(--col-bg); }
  .is-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }
  @media (min-width: 640px) {
    .is-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .is-grid { grid-template-columns: repeat(3, 1fr); gap: var(--sp-10); }
  }

  .is-page-card {
    display: flex;
    flex-direction: column;
    background: var(--col-white);
    border: 1px solid var(--col-border-light);
    border-radius: var(--r-2xl);
    overflow: hidden;
    box-shadow: var(--sh-sm);
    text-decoration: none;
    transition: transform var(--tr-base), box-shadow var(--tr-base);
  }
  .is-page-card:hover,
  .is-page-card:focus-visible {
    transform: translateY(-6px);
    box-shadow: var(--sh-lg);
    outline: none;
  }
  .is-page-card:focus-visible {
    outline: 2px solid var(--col-primary);
    outline-offset: 3px;
  }

  .is-page-card__img-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .is-page-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(1) brightness(0.92);
    transition: filter var(--tr-slow), transform var(--tr-slow);
  }
  .is-page-card:hover .is-page-card__img,
  .is-page-card:focus-visible .is-page-card__img {
    filter: grayscale(0) brightness(1);
    transform: scale(1.05);
  }

  .is-page-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--sp-6);
  }
  .is-page-card__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xl);
    color: var(--col-primary);
    line-height: 1.3;
    margin-bottom: var(--sp-3);
  }
  .is-page-card__desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--col-text-sec);
    line-height: 1.7;
    flex: 1;
    margin-bottom: var(--sp-4);
  }
  .is-page-card__cta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--col-accent);
    transition: color var(--tr-base);
  }
  .is-page-card:hover .is-page-card__cta { color: var(--col-primary); }
</style>
