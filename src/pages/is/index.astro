---
import { IS_LIST } from '../../data/is.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
const prefix = lang === 'fr' ? '' : `/${lang}`;
---

<BaseLayout
  title={t('meta', 'isTitle')}
  description={t('meta', 'isDesc')}
  url={Astro.url.href}
  keywords="institutions spécialisées AMP BENIN, SFPF, SEPE, SPEA, SNIE, SCCS, SBSC, ONG Bénin"
>

  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://ampbenin.netlify.app" },
      { "@type": "ListItem", "position": 2, "name": "Institutions Spécialisées", "item": "https://ampbenin.netlify.app/is" }
    ]
  }
  </script>

  <section class="bg-white py-16 px-4">
    <div class="max-w-6xl mx-auto text-center mb-12">
      <h1 class="text-4xl font-bold text-green-800 mb-4">{t('institutions', 'title')}</h1>
      <p class="text-lg text-gray-700 max-w-3xl mx-auto">
        {t('institutions', 'subtitle')}
      </p>
    </div>

    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">
      {IS_LIST.map((institution) => (
        <a href={`${prefix}/is/${institution.slug}`} class="block bg-gray-100 rounded-xl shadow hover:shadow-lg transition overflow-hidden">
          <img
            src={institution.image}
            alt={`${institution.name} — Institution Spécialisée AMP BENIN`}
            class="w-full h-48 object-cover rounded-t-xl"
            loading="lazy"
            decoding="async"
          />
          <div class="p-6">
            <h2 class="text-xl font-semibold text-green-700 mb-2">{institution.name}</h2>
            <p class="text-gray-700 mb-4">{institution.description}</p>
            <span class="inline-block bg-green-200 text-green-800 px-3 py-1 rounded-full text-sm font-medium">
              {t('institutions', 'learnMore')}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>
