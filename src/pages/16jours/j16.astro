      </p>
    </header>

    <!-- HERO IMAGE -->
    <figure class="w-full mb-10">
      <img 
        src="https://res.cloudinary.com/diongmuh8/image/upload/f_auto,q_auto,w_800/v1780903921/ong-site/images/16jours/og-image-v16.jpg"
