---
const slides = [
  {
    image: "https://res.cloudinary.com/diongmuh8/image/upload/f_auto,q_auto:good,w_1920/v1780903891/ong-site/images/impact-positif-ODD.webp",
    title: "Environnement, Climat et Promotion des ODD",
    subtitle: "Ensemble, promouvons les Objectifs de Développement Durable."
  },
  {
    image: "https://res.cloudinary.com/diongmuh8/image/upload/f_auto,q_auto:good,w_1920/v1780903892/ong-site/images/forum-jeunesse.webp",
    title: "Engagement, Cohésion Sociale et Droits Humains",
    subtitle: "Accompagnons les jeunes et communautés vers un avenir meilleur sans inégalités sociales et violences."
  },
  {
    image: "https://res.cloudinary.com/diongmuh8/image/upload/f_auto,q_auto:good,w_1920/v1780903892/ong-site/images/innovation.webp",
    title: "Innovation, Entrepreneuriat Social et Numérique",
    subtitle: "Soutenons les projets transformateurs dans nos communautés."
  },
  {
    image: "https://res.cloudinary.com/diongmuh8/image/upload/f_auto,q_auto:good,w_1920/v1780903894/ong-site/images/sante-bienetre-social.webp",
    title: "Éducation, Santé et Promotion de l'Enfance",
    subtitle: "Nous intervenons dans les domaines de l'Éducation, Santé communautaire et la Promotion de l'Enfance."
  }
];

const heroStats = [
  { value: "7 000+", label: "Volontaires" },
  { value: "20",     label: "Communes" },
  { value: "12",     label: "Départements" },
];
---

<section class="hero" aria-label="Présentation AMP BENIN">

  <!-- ── Slider ── -->
  <div id="hero-slider" class="hero__track">
    {slides.map((slide, i) => (
      <div
        class={`hero__slide${i === 0 ? " hero__slide--active" : ""}`}
        data-slide-index={i}
        aria-hidden={i !== 0 ? "true" : "false"}
      >
        <img
          src={slide.image}
          alt={slide.title}
          class="hero__img"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : undefined}
          decoding="async"
        />
        <div class="hero__overlay" aria-hidden="true"></div>

        <div class="hero__content">
          <p class="hero__eyebrow">AMP BENIN — Bénin, Afrique</p>
          <h1 class="hero__title">{slide.title}</h1>
          <p class="hero__subtitle">{slide.subtitle}</p>
          <div class="hero__actions">
            <a href="/nos-actions" class="btn btn--accent btn--lg">Découvrir nos actions</a>
            <a href="/adhesion"    class="btn btn--outline-white btn--lg">Nous rejoindre</a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- ── Dots de navigation ── -->
  <div class="hero__dots" role="tablist" aria-label="Sélection de slide">
    {slides.map((_, i) => (
      <button
        class={`hero__dot${i === 0 ? " hero__dot--active" : ""}`}
        data-dot-index={i}
        role="tab"
        aria-label={`Slide ${i + 1}`}
        aria-selected={i === 0 ? "true" : "false"}
      ></button>
    ))}
  </div>

  <!-- ── Réseaux sociaux (desktop) ── -->
  <div class="hero__socials" aria-label="Réseaux sociaux">
    <a href="https://facebook.com/ampbenin.org" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="hero__social">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.5 9.9v-7h-2v-3h2v-2.3c0-2 1.2-3.2 3-3.2.9 0 1.8.2 1.8.2v2h-1c-1 0-1.3.6-1.3 1.2V12h2.3l-.4 3h-1.9v7A10 10 0 0022 12z"/></svg>
    </a>
    <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="hero__social">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26L22.5 21.75h-6.421l-5.03-6.568-5.757 6.568H2.984l7.73-8.828L1.5 2.25h6.58l4.533 6.054L18.244 2.25z"/></svg>
    </a>
    <a href="https://whatsapp.com/channel/0029VaIOnPDEVccHs3abBh1A" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="hero__social">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.87 11.87 0 0012 0C5.37 0 0 5.37 0 12c0 2.11.55 4.17 1.6 6L0 24l6.17-1.58A12 12 0 0012 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.2-3.48-8.52zM12 21.6c-1.87 0-3.68-.5-5.26-1.46l-.38-.23-3.66.94.98-3.56-.25-.38A9.58 9.58 0 012.4 12c0-5.3 4.3-9.6 9.6-9.6 2.56 0 4.97 1 6.77 2.8 1.8 1.8 2.8 4.21 2.8 6.77 0 5.3-4.3 9.6-9.6 9.6zm5.52-7.28c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.77-1.65-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.07c.15.2 2.1 3.2 5.08 4.48.71.31 1.27.49 1.7.63.71.23 1.35.2 1.85.12.57-.09 1.77-.73 2.02-1.43.25-.7.25-1.3.17-1.43-.07-.13-.27-.2-.57-.35z"/></svg>
    </a>
    <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hero__social">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C3.33 3.5 2 4.83 2 6.5s1.33 3 2.98 3c1.65 0 2.98-1.33 2.98-3S6.63 3.5 4.98 3.5zM2 8h6v14H2V8zm7 0h5.5v2h.1c.76-1.44 2.63-2.96 5.4-2.96 5.77 0 6.1 3.8 6.1 8.72V22h-6v-6.9c0-1.65-.03-3.77-2.3-3.77-2.3 0-2.65 1.8-2.65 3.65V22h-6V8z"/></svg>
    </a>
  </div>

  <!-- ── Barre de stats en bas ── -->
  <div class="hero__statsbar" aria-label="Chiffres clés AMP BENIN">
    {heroStats.map((s) => (
      <div class="hero__stat">
        <span class="hero__stat-value">{s.value}</span>
        <span class="hero__stat-label">{s.label}</span>
      </div>
    ))}
  </div>

</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var slides = Array.from(document.querySelectorAll('#hero-slider .hero__slide'));
    var dots   = Array.from(document.querySelectorAll('.hero__dot'));
    var index  = 0;

    function showSlide(newIndex) {
      slides[index].classList.remove('hero__slide--active');
      slides[index].setAttribute('aria-hidden', 'true');
      dots[index].classList.remove('hero__dot--active');
      dots[index].setAttribute('aria-selected', 'false');

      index = newIndex;

      slides[index].classList.add('hero__slide--active');
      slides[index].setAttribute('aria-hidden', 'false');
      dots[index].classList.add('hero__dot--active');
      dots[index].setAttribute('aria-selected', 'true');
    }

    var slideInterval = setInterval(function () {
      showSlide((index + 1) % slides.length);
    }, 5000);

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        clearInterval(slideInterval);
        showSlide(i);
        slideInterval = setInterval(function () {
          showSlide((index + 1) % slides.length);
        }, 5000);
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 560px;
    max-height: 920px;
    overflow: hidden;
    background: var(--col-primary-dark);
  }

  /* Slider */
  .hero__track {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.1s ease;
    z-index: 1;
  }
  .hero__slide--active {
    opacity: 1;
    z-index: 2;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Overlay dégradé directionnel */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(10, 28, 18, 0.88) 0%,
      rgba(15, 42, 30, 0.70) 45%,
      rgba(15, 42, 30, 0.30) 100%
    );
  }

  /* Contenu */
  .hero__content {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--sp-6);
    padding-bottom: calc(var(--sp-6) + 5rem); /* espace pour la statsbar */
    max-width: min(46rem, 90vw);
    margin-left: max(var(--sp-6), calc((100vw - var(--container)) / 2 + var(--sp-6)));
  }
  .hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--col-accent-light);
    margin-bottom: var(--sp-4);
    opacity: 0.9;
  }
  .hero__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(var(--text-3xl), 5.5vw, var(--text-7xl));
    color: var(--col-white);
    line-height: 1.08;
    margin-bottom: var(--sp-5);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.25);
  }
  .hero__subtitle {
    font-family: var(--font-body);
    font-size: clamp(var(--text-base), 2vw, var(--text-xl));
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin-bottom: var(--sp-8);
    max-width: 36rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  /* Dots */
  .hero__dots {
    position: absolute;
    bottom: calc(5rem + var(--sp-6));
    left: max(var(--sp-6), calc((100vw - var(--container)) / 2 + var(--sp-6)));
    display: flex;
    gap: var(--sp-2);
    z-index: 10;
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-full);
    border: none;
    background: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    padding: 0;
    transition: background var(--tr-base), width var(--tr-base);
  }
  .hero__dot--active {
    background: var(--col-accent);
    width: 28px;
  }

  /* Réseaux sociaux */
  .hero__socials {
    position: absolute;
    right: var(--sp-6);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    z-index: 10;
  }
  .hero__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-full);
    color: var(--col-white);
    backdrop-filter: blur(6px);
    transition: background var(--tr-base), border-color var(--tr-base), transform var(--tr-base), color var(--tr-base);
    text-decoration: none;
  }
  .hero__social:hover {
    background: var(--col-accent);
    border-color: var(--col-accent);
    color: var(--col-dark);
    transform: scale(1.12);
  }
  .hero__social svg { width: 1rem; height: 1rem; }

  /* Barre de stats */
  .hero__statsbar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    background: rgba(15, 42, 30, 0.92);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hero__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: var(--sp-4) var(--sp-6);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hero__stat:last-child { border-right: none; }
  .hero__stat-value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-2xl);
    color: var(--col-accent);
    line-height: 1;
  }
  .hero__stat-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: var(--sp-1);
  }

  /* Mobile */
  @media (max-width: 767px) {
    .hero__socials { display: none; }
    .hero__content {
      max-width: 100%;
      margin-left: 0;
      padding: var(--sp-5);
      padding-bottom: calc(var(--sp-5) + 5rem);
    }
    .hero__stat { padding: var(--sp-3) var(--sp-2); }
    .hero__stat-value { font-size: var(--text-xl); }
    .hero__dots {
      left: var(--sp-5);
      bottom: calc(5rem + var(--sp-4));
    }
  }
</style>
