---
// Illustration vectorielle (pas une photo) d'un enfant avec cartable et
// cahier, pour la collecte "Kits scolaires". Choix volontaire : on évite
// de publier une photo (générée ou réelle) d'un enfant présenté comme
// orphelin/démuni sur une page qui demande de l'argent — question de
// consentement/protection de l'enfance autant que d'honnêteté envers les
// donateurs (une photo suggérerait un vrai enfant identifiable).
// Couleurs pilotées par tokens.css (voir <style> plus bas) pour rester
// cohérent avec la charte AMP BENIN et suivre un éventuel changement de
// palette sans retoucher le SVG.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={`skc ${className}`}
  viewBox="0 0 240 240"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Illustration d'un enfant souriant portant un cartable et tenant un cahier"
>
  <circle class="skc-bg" cx="120" cy="120" r="115" />
  <ellipse class="skc-shadow" cx="120" cy="208" rx="42" ry="8" />

  <!-- Sac à dos (derrière le corps, dépasse de chaque côté des épaules) -->
  <rect class="skc-bag" x="78" y="90" width="84" height="90" rx="18" />
  <rect class="skc-bag-flap" x="93" y="90" width="54" height="26" rx="10" />
  <circle class="skc-bag-pocket" cx="120" cy="150" r="9" />

  <!-- Bretelles du sac par-dessus le t-shirt -->
  <rect class="skc-strap" x="98" y="118" width="9" height="55" rx="4.5" />
  <rect class="skc-strap" x="133" y="118" width="9" height="55" rx="4.5" />

  <!-- Jambes et chaussures -->
  <rect class="skc-skin" x="100" y="175" width="16" height="35" rx="6" />
  <rect class="skc-skin" x="124" y="175" width="16" height="35" rx="6" />
  <rect class="skc-shoes" x="96" y="204" width="24" height="12" rx="6" />
  <rect class="skc-shoes" x="120" y="204" width="24" height="12" rx="6" />

  <!-- Short -->
  <rect class="skc-shorts" x="94" y="158" width="52" height="30" rx="10" />

  <!-- T-shirt -->
  <rect class="skc-shirt" x="90" y="116" width="60" height="52" rx="20" />

  <!-- Bras -->
  <rect class="skc-skin" x="150" y="122" width="14" height="44" rx="7" transform="rotate(14 157 122)" />
  <rect class="skc-skin" x="76" y="116" width="14" height="40" rx="7" transform="rotate(-38 83 116)" />

  <!-- Cahier tenu devant, tenu par le bras plié -->
  <g transform="rotate(-8 75 166)">
    <rect class="skc-notebook" x="55" y="140" width="40" height="52" rx="4" />
    <circle class="skc-notebook-spine" cx="59" cy="150" r="2" />
    <circle class="skc-notebook-spine" cx="59" cy="160" r="2" />
    <circle class="skc-notebook-spine" cx="59" cy="170" r="2" />
    <circle class="skc-notebook-spine" cx="59" cy="180" r="2" />
    <rect class="skc-notebook-line" x="66" y="151" width="24" height="3" rx="1.5" />
    <rect class="skc-notebook-line" x="66" y="161" width="24" height="3" rx="1.5" />
    <rect class="skc-notebook-line" x="66" y="171" width="18" height="3" rx="1.5" />
  </g>

  <!-- Tête -->
  <circle class="skc-skin" cx="120" cy="94" r="29" />
  <path class="skc-hair" d="M91 92 C91 68 149 68 149 92 C149 76 136 60 120 60 C104 60 91 76 91 92 Z" />
  <circle class="skc-hair" cx="89" cy="90" r="9" />
  <circle class="skc-hair" cx="151" cy="90" r="9" />
  <circle class="skc-eyes" cx="110" cy="96" r="2.6" />
  <circle class="skc-eyes" cx="130" cy="96" r="2.6" />
  <path class="skc-mouth" d="M108 105 Q120 114 132 105" fill="none" stroke-width="3" stroke-linecap="round" />

  <!-- Étincelles de joie -->
  <path class="skc-sparkle" d="M45 60 l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3 z" />
  <path class="skc-sparkle" d="M195 150 l2.5 6.5 6.5 2.5 -6.5 2.5 -2.5 6.5 -2.5 -6.5 -6.5 -2.5 6.5 -2.5 z" />
  <circle class="skc-sparkle" cx="185" cy="70" r="4" />
</svg>

<style>
  .skc { display: block; width: 100%; height: auto; }
  .skc-bg { fill: var(--col-primary-bg); }
  .skc-shadow { fill: rgba(15, 42, 30, 0.12); }

  .skc-bag { fill: var(--col-primary); }
  .skc-bag-flap { fill: var(--col-accent); }
  .skc-bag-pocket { fill: var(--col-primary-light); }
  .skc-strap { fill: var(--col-primary-dark); }

  .skc-skin { fill: #8B5E3C; }
  .skc-shoes { fill: #2B2118; }
  .skc-shorts { fill: var(--col-primary-dark); }
  .skc-shirt { fill: var(--col-accent-light); }

  .skc-notebook { fill: #FFFDF7; stroke: var(--col-border); stroke-width: 1.5; }
  .skc-notebook-line { fill: var(--col-border); }
  .skc-notebook-spine { fill: var(--col-primary-light); }

  .skc-hair { fill: #2B1B12; }
  .skc-eyes { fill: #2B1B12; }
  .skc-mouth { stroke: #2B1B12; }

  .skc-sparkle { fill: var(--col-accent); opacity: 0.7; }
</style>
