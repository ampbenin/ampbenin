---
const { partner } = Astro.props;
const inner = (
  <>
    {partner.logoUrl && <img src={partner.logoUrl} alt={partner.name} class="h-14 w-auto max-w-[160px] object-contain" />}
    <span class="block w-full break-words text-center text-sm text-gray-800">{partner.name}</span>
  </>
);
---

{partner.websiteUrl ? (
  <a href={partner.websiteUrl} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center gap-2 w-40 hover:opacity-80">
    {inner}
  </a>
) : (
  <div class="flex flex-col items-center gap-2 w-40">{inner}</div>
)}
