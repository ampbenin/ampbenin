---
import { useTranslations, resolveLang } from '../i18n/utils';
const lang = resolveLang(Astro);
const t = useTranslations(lang);
---

<section class="campagne section-py" aria-labelledby="campagne-title">
  <div class="container">
    <div class="campagne__grid">

      <div class="campagne__media fade-up">
        <div class="campagne__img-wrap">
          <img
            src="https://res.cloudinary.com/diongmuh8/image/upload/f_auto,q_auto:good,w_1920/v1780903906/ong-site/images/16jours/Lancement-16jours.webp"
            alt="Lancement de la campagne 16 Jours d'activisme contre les violences basées sur le genre — AMP BENIN 2025"
            class="campagne__img"
            loading="lazy"
            decoding="async"
            width="800"
            height="600"
          />
          <div class="campagne__img-badge">
            <span>2025</span>
            <span>{t('campagne16j', 'badgeLabel')}</span>
          </div>
        </div>
      </div>

      <div class="campagne__body fade-up" style="transition-delay:0.12s">
        <span class="section-label section-label--accent">{t('campagne16j', 'hashtag')}</span>
        <h2 id="campagne-title" class="campagne__title">{t('campagne16j', 'title')}</h2>
        <p class="campagne__desc">{t('campagne16j', 'desc')}</p>
        <!-- 16jours articles are French-only — no lang prefix -->
        <a href="/16jours" class="btn btn--primary btn--lg">
          {t('campagne16j', 'btn')} &rarr;
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .campagne { background: var(--col-surface); }
  .campagne__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-10);
    align-items: center;
  }
  @media (min-width: 768px) {
    .campagne__grid { grid-template-columns: 11fr 9fr; gap: var(--sp-16); }
  }

  .campagne__img-wrap {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--sh-lg);
  }
  .campagne__img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
    transition: transform var(--tr-slow);
  }
  .campagne__img-wrap:hover .campagne__img { transform: scale(1.04); }

  .campagne__img-badge {
    position: absolute;
    bottom: var(--sp-4);
    inset-inline-start: var(--sp-4);
    background: var(--col-primary);
    color: var(--col-white);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.2;
    box-shadow: var(--sh-md);
  }
  .campagne__img-badge span:first-child {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--col-accent);
  }
  .campagne__img-badge span:last-child {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .campagne__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(var(--text-2xl), 3.5vw, var(--text-4xl));
    color: var(--col-primary);
    line-height: 1.18;
    margin-bottom: var(--sp-5);
  }
  .campagne__desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--col-text-sec);
    line-height: 1.7;
    margin-bottom: var(--sp-8);
  }
</style>
