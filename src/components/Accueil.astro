---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
const prefix = lang === 'fr' ? '' : `/${lang}`;
---

<section
  class="welcome section-py"
  data-welcome-title={t('welcome', 'title')}
  data-welcome-desc={t('welcome', 'desc')}
>
  <div class="container">
    <div class="welcome__grid">

      <!-- Colonne texte (large) -->
      <div class="welcome__text fade-up">
        <span class="section-label section-label--green">{t('welcome', 'label')}</span>
        <h2 id="welcome-title" class="welcome__title"></h2>
        <p  id="welcome-text"  class="welcome__desc"></p>
        <div class="welcome__ctas">
          <a href={`${prefix}/a-propos`}    class="btn btn--primary btn--lg">{t('welcome', 'btnLearn')}</a>
          <a href={`${prefix}/nos-actions`} class="btn btn--ghost">{t('welcome', 'btnActions')} &rarr;</a>
        </div>
      </div>

      <!-- Colonne décorative (étroite) -->
      <div class="welcome__deco fade-up" style="transition-delay:0.15s">
        <div class="welcome__badge">
          <span class="welcome__badge-year">2021</span>
          <span class="welcome__badge-line">{t('welcome', 'badgeLabel')}</span>
        </div>
        <div class="welcome__ring welcome__ring--1"></div>
        <div class="welcome__ring welcome__ring--2"></div>
        <p class="welcome__deco-caption">{t('welcome', 'decoCaption')}</p>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var section     = document.querySelector('.welcome[data-welcome-title]');
    var title       = section ? section.dataset.welcomeTitle : 'Bienvenue sur AMP BENIN';
    var description = section ? section.dataset.welcomeDesc  : '';

    var titleContainer = document.getElementById("welcome-title");
    var textContainer  = document.getElementById("welcome-text");

    function typeText(container, text, delay, callback) {
      container.textContent = "";
      var i = 0;
      var interval = setInterval(function () {
        container.textContent += text.charAt(i);
        i++;
        if (i >= text.length) {
          clearInterval(interval);
          if (callback) callback();
        }
      }, delay);
    }

    typeText(titleContainer, title, 80, function () {
      setTimeout(function () {
        typeText(textContainer, description, 18);
      }, 400);
    });
  });
</script>

<style>
  .welcome { background: var(--col-bg); }

  .welcome__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
    align-items: center;
  }
  @media (min-width: 768px) {
    .welcome__grid { grid-template-columns: 3fr 2fr; }
  }

  .welcome__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    color: var(--col-primary);
    margin-bottom: var(--sp-5);
    min-height: 2.4em;
    line-height: 1.15;
  }
  .welcome__title::after {
    content: '|';
    display: inline-block;
    margin-inline-start: 2px;
    color: var(--col-accent);
    animation: blink 1s steps(1) infinite;
  }
  .welcome__desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--col-text-sec);
    line-height: 1.75;
    margin-bottom: var(--sp-8);
    min-height: 6rem;
  }
  .welcome__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
  }

  .welcome__deco {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }
  @media (max-width: 767px) { .welcome__deco { order: -1; } }

  .welcome__badge {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: var(--r-full);
    background: var(--col-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: var(--sh-lg);
    z-index: 2;
  }
  .welcome__badge-year {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-4xl);
    color: var(--col-accent);
    line-height: 1;
  }
  .welcome__badge-line {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin-top: var(--sp-1);
  }
  .welcome__ring {
    position: absolute;
    border-radius: var(--r-full);
    border: 2px solid var(--col-accent);
    opacity: 0;
    animation: ring-pulse 3s ease-in-out infinite;
  }
  .welcome__ring--1 { width: 180px; height: 180px; animation-delay: 0s;  margin-top: -160px; }
  .welcome__ring--2 { width: 210px; height: 210px; animation-delay: 1s;  margin-top: -160px; }
  .welcome__deco-caption {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--col-text-muted);
    text-align: center;
    max-width: 180px;
    line-height: 1.5;
    font-style: italic;
  }

  @keyframes blink {
    0%, 50%, 100% { opacity: 1; }
    25%, 75%      { opacity: 0; }
  }
  @keyframes ring-pulse {
    0%   { transform: scale(0.95); opacity: 0.4; }
    50%  { transform: scale(1.06); opacity: 0.08; }
    100% { transform: scale(0.95); opacity: 0.4; }
  }
</style>
