---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);
const prefix = lang === 'fr' ? '' : `/${lang}`;

const stats = [
  { label: t('ampstats', 'country'),       value: 1,    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>` },
  { label: t('ampstats', 'departments'),   value: 12,   icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>` },
  { label: t('ampstats', 'municipalities'),value: 20,   icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>` },
  { label: t('ampstats', 'volunteers'),    value: 7000, icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>` },
];
const bgImage = "https://res.cloudinary.com/diongmuh8/image/upload/f_auto,q_auto,w_1600/v1780903896/ong-site/images/ouidah.webp";
---

<section class="amps section-py" aria-labelledby="amps-title">

  <div class="amps__bg" aria-hidden="true">
    <div class="amps__bg-img parallax-layer" data-speed="0.18" style={`background-image: url('${bgImage}')`}></div>
    <div class="amps__halo amps__halo--1 parallax-layer" data-speed="0.06"></div>
    <div class="amps__halo amps__halo--2 parallax-layer" data-speed="0.10"></div>
    <div class="amps__overlay"></div>
  </div>

  <div class="container amps__inner">

    <div class="amps__intro" data-anim="reveal">
      <h2 id="amps-title" class="amps__title">
        <span class="amps__title-line">
          <span class="reveal-piece">AMP BENIN</span>
        </span>
        <span class="amps__title-sub reveal-sub">{t('ampstats', 'tagline')}</span>
      </h2>
      <p class="amps__desc" data-anim="fade">{t('ampstats', 'desc')}</p>
      <div class="amps__ctas" data-anim="fade">
        <a href={`${prefix}/a-propos`} class="btn btn--outline-white btn--lg">
          {t('ampstats', 'btnLearn')}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <div class="amps__grid">
      {stats.map((s, i) => (
        <article class="amps__card" data-anim="card" aria-label={`${s.label} : ${s.value}`}>
          <div class="amps__card-icon" set:html={s.icon} />
          <div class="amps__card-num">
            <span class="stat-value" data-value={s.value}>0</span>
            {s.value >= 1000 && <span class="amps__card-suffix">+</span>}
          </div>
          <p class="amps__card-label">{s.label}</p>
          <div class="amps__card-glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>

  </div>

  <div class="amps__fade-bottom" aria-hidden="true"></div>
</section>

<script type="module">
  const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  (function () {
    const layers = [...document.querySelectorAll('.parallax-layer')];
    if (!layers.length || prefersReduced) return;
    let rafId = null;
    function onScroll() {
      if (rafId) return;
      rafId = requestAnimationFrame(() => {
        const scrollY = window.scrollY || window.pageYOffset;
        layers.forEach(layer => {
          const speed = parseFloat(layer.dataset.speed) || 0;
          layer.style.transform = `translateY(${scrollY * speed}px)`;
        });
        rafId = null;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();

  (function () {
    if (prefersReduced) {
      document.querySelectorAll('[data-anim]').forEach(el => el.style.opacity = 1);
      document.querySelectorAll('.reveal-piece, .reveal-sub').forEach(el => el.style.transform = 'none');
      return;
    }
    document.querySelectorAll('.reveal-piece').forEach((el, idx) => {
      el.style.transition = 'transform 800ms cubic-bezier(.2,.9,.3,1), opacity 600ms ease';
      el.style.transitionDelay = `${idx * 90}ms`;
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    });
    document.querySelectorAll('.reveal-sub').forEach(el => {
      el.style.transition = 'transform 900ms cubic-bezier(.2,.9,.3,1), opacity 600ms ease';
      el.style.transitionDelay = '200ms';
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    });
    document.querySelectorAll('[data-anim="fade"]').forEach((el, idx) => {
      el.style.transition = 'opacity 900ms ease, transform 900ms ease';
      el.style.transitionDelay = `${220 + idx * 80}ms`;
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
    document.querySelectorAll('[data-anim="card"]').forEach((el, idx) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(28px)';
      setTimeout(() => {
        el.style.transition = 'opacity 700ms ease, transform 700ms cubic-bezier(.2,.9,.3,1)';
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      }, 300 + idx * 110);
    });
  })();

  (function () {
    const elements = [...document.querySelectorAll('.stat-value')];
    if (!elements.length) return;
    function animateCount(el, to) {
      const duration = 1400, start = performance.now();
      function step(now) {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = Math.round(to * eased).toLocaleString('fr-FR');
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    if (prefersReduced) {
      elements.forEach(el => el.textContent = Number(el.dataset.value || 0).toLocaleString('fr-FR'));
      return;
    }
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCount(entry.target, Number(entry.target.dataset.value || 0));
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });
    elements.forEach(el => io.observe(el));
  })();
</script>

<style>
  .amps {
    position: relative;
    overflow: hidden;
    color: var(--col-white);
    min-height: 600px;
  }

  .amps__bg { position: absolute; inset: 0; z-index: 0; }
  .amps__bg-img {
    position: absolute;
    inset: -10%;
    background-size: cover;
    background-position: center;
    will-change: transform;
  }

  .amps__halo {
    position: absolute;
    border-radius: var(--r-full);
    filter: blur(80px);
    pointer-events: none;
    will-change: transform;
  }
  .amps__halo--1 {
    top: 4%; inset-inline-start: -6%;
    width: 36rem; height: 36rem;
    background: radial-gradient(circle, rgba(201,144,58,0.20) 0%, transparent 70%);
    opacity: 0.7;
  }
  .amps__halo--2 {
    bottom: 4%; inset-inline-end: -6%;
    width: 44rem; height: 44rem;
    background: radial-gradient(circle, rgba(82,183,136,0.18) 0%, transparent 70%);
    opacity: 0.7;
  }

  .amps__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(10,28,18,0.78) 0%, rgba(15,42,30,0.72) 60%, rgba(10,28,18,0.86) 100%);
    z-index: 1;
  }

  .amps__inner { position: relative; z-index: 10; text-align: center; }

  [data-anim], .reveal-piece, .reveal-sub {
    opacity: 0;
    transform: translateY(12px);
  }
  .reveal-piece { display: inline-block; transform: translateY(18px); }
  .reveal-sub   { display: block; transform: translateY(12px); }

  @media (prefers-reduced-motion: reduce) {
    .reveal-piece, .reveal-sub, [data-anim], .parallax-layer {
      transition: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }

  .amps__intro { margin-bottom: var(--sp-16); }
  .amps__title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(var(--text-4xl), 7vw, var(--text-7xl));
    line-height: 1.05;
    margin-bottom: var(--sp-5);
    color: var(--col-white);
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.30);
  }
  .amps__title-line { display: block; overflow: hidden; }
  .amps__title-sub {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(var(--text-lg), 2.5vw, var(--text-2xl));
    color: rgba(255, 255, 255, 0.70);
    margin-top: var(--sp-3);
  }
  .amps__desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.65);
    max-width: 42rem;
    margin-inline: auto;
    line-height: 1.7;
    margin-bottom: var(--sp-8);
  }
  .amps__ctas { display: flex; justify-content: center; }
  .amps__ctas .btn svg { width: 1rem; height: 1rem; margin-inline-start: var(--sp-2); }

  .amps__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-5);
    max-width: 56rem;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .amps__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .amps__card {
    position: relative;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--r-xl);
    padding: var(--sp-7) var(--sp-5);
    text-align: center;
    overflow: hidden;
    will-change: transform, opacity;
    transition: transform var(--tr-base), box-shadow var(--tr-base), background var(--tr-base);
    backdrop-filter: blur(8px);
  }
  .amps__card:hover {
    transform: translateY(-6px) scale(1.02);
    background: rgba(255, 255, 255, 0.11);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.30);
  }

  .amps__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: rgba(201, 144, 58, 0.15);
    border-radius: var(--r-lg);
    margin: 0 auto var(--sp-4);
    color: var(--col-accent-light);
  }
  .amps__card-icon :global(svg) { width: 1.5rem; height: 1.5rem; }

  .amps__card-num {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
    margin-bottom: var(--sp-2);
  }
  .stat-value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    color: var(--col-white);
    line-height: 1;
  }
  .amps__card-suffix {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-2xl);
    color: var(--col-accent);
  }
  .amps__card-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.60);
    line-height: 1.4;
  }

  .amps__card-glow {
    position: absolute;
    inset: 0;
    border-radius: var(--r-xl);
    background: radial-gradient(circle at 50% -10%, rgba(201,144,58,0.20), transparent 60%);
    opacity: 0;
    transition: opacity var(--tr-base);
    pointer-events: none;
  }
  .amps__card:hover .amps__card-glow { opacity: 1; }

  .amps__fade-bottom {
    position: absolute;
    inset-x: 0;
    bottom: 0;
    height: 6rem;
    background: linear-gradient(to top, rgba(10, 28, 18, 0.65), transparent);
    pointer-events: none;
    z-index: 5;
  }

  @media (max-width: 479px) {
    .amps__grid { grid-template-columns: 1fr; }
  }
</style>
