---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const t = useTranslations(lang);

const stats = [
  {
    label: t('impact', 'country'),
    value: 1,
    suffix: "",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`
  },
  {
    label: t('impact', 'departments'),
    value: 12,
    suffix: "",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>`
  },
  {
    label: t('impact', 'municipalities'),
    value: 20,
    suffix: "",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
  {
    label: t('impact', 'volunteers'),
    value: 7000,
    suffix: "+",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`
  }
];
---

<section class="impact section-py" aria-labelledby="impact-title">
  <div class="container">

    <div class="impact__header fade-up">
      <span class="section-label section-label--white">{t('impact', 'label')}</span>
      <h2 id="impact-title" class="impact__title">{t('impact', 'title')}</h2>
      <p class="impact__subtitle">{t('impact', 'subtitle')}</p>
    </div>

    <div class="impact__grid">
      {stats.map((s, i) => (
        <article
          class="impact__card fade-up"
          style={`transition-delay:${i * 0.1}s`}
          aria-label={`${s.label} : ${s.value}${s.suffix}`}
        >
          <div class="impact__card-icon" set:html={s.icon} />
          <div class="impact__card-body">
            <div class="impact__card-num">
              <span class="stat-counter" data-value={s.value}>0</span>
              <span class="impact__card-suffix">{s.suffix}</span>
            </div>
            <p class="impact__card-label">{s.label}</p>
          </div>
          <div class="impact__card-glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>

  </div>
</section>

<script type="module">
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = [...document.querySelectorAll('.stat-counter')];

  function animateCount(el, target) {
    const duration = 1500;
    const start    = performance.now();
    function step(now) {
      const t      = Math.min(1, (now - start) / duration);
      const eased  = 1 - Math.pow(1 - t, 3);
      const value  = Math.round(target * eased);
      el.textContent = value.toLocaleString('fr-FR');
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  if (prefersReduced) {
    counters.forEach(el => {
      el.textContent = Number(el.dataset.value).toLocaleString('fr-FR');
    });
  } else {
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCount(entry.target, Number(entry.target.dataset.value));
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach(el => io.observe(el));
  }
</script>

<style>
  .impact {
    background: var(--col-primary);
    color: var(--col-white);
    position: relative;
    overflow: hidden;
  }

  .impact::before {
    content: '';
    position: absolute;
    top: -6rem;
    inset-inline-end: -6rem;
    width: 32rem;
    height: 32rem;
    border-radius: var(--r-full);
    background: radial-gradient(circle, rgba(201,144,58,0.12) 0%, transparent 70%);
    pointer-events: none;
  }
  .impact::after {
    content: '';
    position: absolute;
    bottom: -8rem;
    inset-inline-start: -4rem;
    width: 28rem;
    height: 28rem;
    border-radius: var(--r-full);
    background: radial-gradient(circle, rgba(82,183,136,0.10) 0%, transparent 70%);
    pointer-events: none;
  }

  .impact__header {
    text-align: center;
    margin-bottom: var(--sp-16);
    position: relative;
    z-index: 2;
  }
  .impact__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    color: var(--col-white);
    margin-bottom: var(--sp-4);
    line-height: 1.15;
  }
  .impact__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.70);
    max-width: 42rem;
    margin-inline: auto;
    line-height: 1.6;
  }

  .impact__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-5);
    position: relative;
    z-index: 2;
  }
  @media (min-width: 1024px) {
    .impact__grid { grid-template-columns: repeat(4, 1fr); }
  }

  .impact__card {
    position: relative;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--r-xl);
    padding: var(--sp-8) var(--sp-6);
    text-align: center;
    overflow: hidden;
    transition: transform var(--tr-base), background var(--tr-base), box-shadow var(--tr-base);
  }
  .impact__card:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.10);
    box-shadow: var(--sh-accent);
  }

  .impact__card-glow {
    position: absolute;
    inset: 0;
    border-radius: var(--r-xl);
    background: radial-gradient(circle at 50% 0%, rgba(201,144,58,0.18), transparent 60%);
    opacity: 0;
    transition: opacity var(--tr-base);
    pointer-events: none;
  }
  .impact__card:hover .impact__card-glow { opacity: 1; }

  .impact__card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background: rgba(201, 144, 58, 0.15);
    border-radius: var(--r-lg);
    margin: 0 auto var(--sp-5);
    color: var(--col-accent-light);
    position: relative;
    z-index: 1;
  }
  .impact__card-icon :global(svg) { width: 1.75rem; height: 1.75rem; }

  .impact__card-body { position: relative; z-index: 1; }

  .impact__card-num {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
    margin-bottom: var(--sp-2);
  }
  .stat-counter {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    color: var(--col-white);
    line-height: 1;
  }
  .impact__card-suffix {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-3xl);
    color: var(--col-accent);
  }
  .impact__card-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  @media (max-width: 479px) {
    .impact__grid { grid-template-columns: 1fr; }
  }
</style>
